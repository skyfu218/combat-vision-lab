{
  "hosting": {
    "site": "combat-vision-lab-skyfu218-v2",
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      "site-release/**",
      "test-videos/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "cleanUrls": true
  }
}
